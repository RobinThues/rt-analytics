    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "google-auth-library": "^11.3.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "rt-analytics": "*",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
