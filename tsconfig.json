{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "rt-analytics": ["./src/index.ts"],
      "rt-analytics/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src", "scripts", "tsdown.config.ts", "vitest.config.ts"]
}
